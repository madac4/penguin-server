# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=7777
API_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/penguin_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES=7d
JWT_REFRESH_SECRET=change_me_to_another_strong_secret
JWT_REFRESH_EXPIRES=30d

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=some_account_id
R2_ACCESS_KEY=some_access_key
R2_SECRET_KEY=some_secret_key
R2_PUBLIC_BUCKET=penguin-public-assets
R2_PUBLIC_URL=https://assets.your-domain.com
R2_PRIVATE_BUCKET=penguin-private-assets

# ─── Mail (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
MAIL_FROM=Penguin <noreply@penguin.dev>

# ─── Client ───────────────────────────────────────────────────────────────────
# Frontend URL used for email confirmation links
CLIENT_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces, or spaces are trimmed)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ─── Lemon Squeezy ────────────────────────────────────────────────────────────
# API key from https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
# Found in https://app.lemonsqueezy.com/settings/stores
LEMON_SQUEEZY_STORE_ID=
# Variant ID of the generic "Model Purchase" product
LEMON_SQUEEZY_VARIANT_ID=
# Secret you entered when creating the orders webhook in LS dashboard
LEMON_SQUEEZY_WEBHOOK_SECRET=
